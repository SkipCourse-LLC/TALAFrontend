# Public build-time setting, NOT a secret. Copy to .env.local if needed.
# Existing presentation demo. Use npm run dev:firebase for the isolated SDK backend.
# Changing this flag alone never enables live auth.
VITE_DEMO_MODE=true
# Opt-in local QA controls (simulated errors and loading states). Keep off for demos.
VITE_DEMO_TOOLS=false
# Never place private SkipCourse credentials, passwords, or tokens in VITE_*.
# Modes: demo | firebase-emulator | firebase-test. Legacy firebase mode is blocked.
# Approved test cloud settings belong in .env.firebase-test.local (see example).
VITE_BACKEND_MODE=demo
# Public SDK placeholders. Production access remains disabled.
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_TOTP_APPROVED=false
