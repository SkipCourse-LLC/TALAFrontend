# Placeholders only. Real values live outside the repository, for example in
# %USERPROFILE%\.tala\server.env, and are loaded with:
#   node --env-file="%USERPROFILE%\.tala\server.env" index.cjs
# The leak scan blocks commits and pushes that contain real Google secrets.

TALA_MEETING_ADAPTER=google-meet
TALA_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
TALA_GOOGLE_CLIENT_SECRET=your-client-secret
TALA_GOOGLE_REFRESH_TOKEN=your-refresh-token
TALA_GMAIL_SENDER=sender@your-domain.example
# Optional; empty means the sender's main calendar.
TALA_GOOGLE_CALENDAR_ID=
