# Server-only configuration for an authorized, isolated synthetic-data test project.
# Do not use SkipClass, do not rename this to .env.<production-project>, do not commit real runtime files.
TALA_ENVIRONMENT=test
TALA_TEST_PROJECT_ID=replace-with-approved-test-project
TALA_TEST_ENVIRONMENT_APPROVED=false
TALA_SYNTHETIC_ONLY=true
TALA_TEST_STORAGE_BUCKET=replace-with-approved-test-project.firebasestorage.app
TALA_TEST_ALLOWED_ORIGINS=https://replace-with-approved-test-host.invalid
TALA_TEST_STUDENT_EMAILS=
# No Admin SDK key: use the approved cloud runtime's managed service identity.
# Deployment and test account creation still require explicit Sponsor authorization.
