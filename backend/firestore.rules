rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Isolated Emulator contract. Never deploy over the SkipClass production rules.
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid && request.auth.token.email.matches('.*@example[.]test'); }
    function student() {
      return signedIn() && request.auth.token.role == 'student'
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@example[.]test')
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student';
    }
    match /users/{uid} {
      allow get: if owner(uid) && request.auth.token.email.matches('.*@example[.]test');
      allow list, create, delete: if false;
      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'updatedAt'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt'])
          || request.resource.data.updatedAt == request.time)
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 80;
    }
    match /tala_local_slots/{slotId} {
      allow read: if student();
      allow write: if false;
    }
    match /tala_local_appointments/{appointmentId} {
      allow read: if student() && owner(resource.data.ownerUid);
      allow write: if false;
    }
    match /tala_local_uploads/{uploadId} {
      allow read: if student() && owner(resource.data.ownerUid);
      allow write: if false;
    }
    match /tala_local_evidence/{evidenceId} {
      allow read: if student() && owner(resource.data.ownerUid);
      allow write: if false;
    }
    match /tala_local_progress/{uid} {
      allow get: if student() && owner(uid);
      allow list, write: if false;
    }
    match /tala_local_meeting_records/{recordId} {
      allow read: if student() && owner(resource.data.ownerUid) && resource.data.status == 'published';
      allow write: if false;
    }
    // Relationship/consent documents and acknowledgement receipts are returned only
    // through authenticated server functions, which minimize the disclosed fields.
    // Locks, idempotency receipts and all unspecified data are server-only.
    match /{document=**} { allow read, write: if false; }
  }
}
