# Everything here ships to the browser. Never put secrets in VITE_* values.

# api: the local Node/SQLite server (default). demo: sample data, no server.
VITE_BACKEND_MODE=api
# Show sample data in the demo screens.
VITE_DEMO_MODE=false
# Show QA controls in the demo screens.
VITE_DEMO_TOOLS=false

# Admin page (#/admin): public Firebase web config for project skip-class-slsru4.
# Leave blank to disable the admin page.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
