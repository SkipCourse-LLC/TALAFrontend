# Public browser configuration only. No credentials or secrets belong in VITE_*.
# Default product uses the independent local Node/SQLite API through /api.
# npm run dev starts the API and website; no Firebase project is needed.
VITE_BACKEND_MODE=api
VITE_DEMO_MODE=false
VITE_DEMO_TOOLS=false

# Historical presentation-only mode: npm run dev:demo explicitly sets demo mode.
# Legacy Firebase commands are opt-in, separate from the default application.
# Optional public SDK placeholders; never add service-account keys or secrets.
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_TOTP_APPROVED=false
