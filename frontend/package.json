{
  "name": "tala-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/startApplication.mjs",
    "dev:app": "node scripts/startApplication.mjs",
    "dev:demo": "node scripts/startApplication.mjs --demo",
    "dev:firebase": "node scripts/firebase-dev.mjs",
    "dev:test-cloud": "vite --mode firebase-test --host 127.0.0.1 --port 5177 --strictPort",
    "build:test-cloud": "npm run typecheck && vite build --mode firebase-test",
    "test:firebase-core": "playwright test -c src/backend/firebaseCore.config.ts",
    "test:firebase-browser": "playwright test -c tests/firebaseIntegration.config.ts",
    "test:cloud-boundary": "playwright test -c tests/firebaseCloudArchitecture.config.ts",
    "test:api-client": "playwright test -c src/api/apiUnit.config.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/*.ts\" index.html package.json tsconfig.json vite.config.ts playwright.config.ts eslint.config.js"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "otpauth": "9.5.2",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "jsqr": "1.4.0",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0"
  }
}
